# CommerceMind 环境变量
# docker compose 部署时会自动读取此文件

# ── Anthropic / DeepSeek ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=xxx
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
# docker compose 的 redis 服务密码；生产环境请改成随机强密码。
REDIS_PASSWORD=commercemind123
# docker compose 内部地址（app 容器通过服务名 redis 访问）。
REDIS_URL=redis://:commercemind123@redis:6379/0
# 在宿主机直接运行 uvicorn 时，改成：
# REDIS_URL=redis://:commercemind123@localhost:6379/0

# ── ChromaDB（知识库、情景记忆、用户画像）─────────────────────────────────────
# docker compose 内部地址（app 容器通过服务名 chromadb 访问）。
# 注意：chromadb 容器的 8000 映射到宿主机 8001，避免和 app 的 8000 冲突。
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 在宿主机直接运行 uvicorn 时，改成：
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
# 本地嵌入式模式路径（仅 development；优先连接独立 ChromaDB 服务）。
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
# 仅 development 自动导入示例政策；生产空库不会自动添加示例。
COMMERCEMIND_SEED_DEMO_DOCS=true

# ── 记忆策略 ──────────────────────────────────────────────────────────────────
# 记忆模块总开关。
COMMERCEMIND_MEMORY_ENABLED=true
# true：Redis/Chroma 不可用时启动直接失败；false：/chat 降级为无记忆继续回答。
COMMERCEMIND_MEMORY_REQUIRED=false
# 短期记忆 TTL：默认 7 天。每次提交消息会刷新。
COMMERCEMIND_MEMORY_TTL_SECONDS=604800
# working memory 的完整消息列表达到该 token 数时，走原有 summary + 截断流程。
# 只统计 working memory，不是模型上下文上限。
COMMERCEMIND_MEMORY_COMPACT_TRIGGER_TOKENS=10800
# 后台维护：容量包含排队中 + 运行中的不同会话；满时跳过维护，不阻塞聊天。
COMMERCEMIND_MEMORY_MAINTAIN_MAX_PENDING=128
COMMERCEMIND_MEMORY_MAINTAIN_WORKERS=2
# 首次失败/冲突后最多再试 2 次；指数退避，默认上限 5 秒。
COMMERCEMIND_MEMORY_MAINTAIN_MAX_RETRIES=2
COMMERCEMIND_MEMORY_MAINTAIN_RETRY_DELAY_S=0.25
# episode / 画像待写扫描结束后等待的秒数；没有新聊天也重试。
COMMERCEMIND_MEMORY_MAINTAIN_PENDING_INTERVAL_S=5
# 长期情景记忆检索：top-k、最低相似度、形成 episode 的最少轮次。
COMMERCEMIND_MEMORY_RETRIEVAL_TOP_K=3
COMMERCEMIND_MEMORY_RETRIEVAL_MIN_SCORE=0.55
COMMERCEMIND_MEMORY_EPISODE_MIN_TURNS=2
# 检索返回的情景记忆文本（含条目间空行）的总 token 上限。
COMMERCEMIND_MEMORY_EPISODE_MAX_TOKENS=600
# 仅开发环境开启：开放只读 GET /memory/{session_id}；false 时路由返回 404。
COMMERCEMIND_MEMORY_DEBUG=false

# 情景记忆与画像共用 Embedding：auto 有 Key 用硅基流动，无 Key 用本地默认模型。
COMMERCEMIND_MEMORY_EMBEDDING_PROVIDER=auto
COMMERCEMIND_MEMORY_EMBEDDING_MODEL=BAAI/bge-m3
COMMERCEMIND_MEMORY_EMBEDDING_URL=https://api.siliconflow.cn/v1/embeddings
# 画像切换模型后的精确读取/显式迁移来源；默认是旧的一维画像 collection。
# 不自动批量迁移；调用 await profiles.reindex_user(user_id) 为指定用户重建向量。
# COMMERCEMIND_MEMORY_PROFILE_SOURCE_COLLECTION=user_profiles_v1

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=

# 每次模型请求的超时（秒）；聊天请求另有 50 秒总预算。
COMMERCEMIND_INTENT_TIMEOUT_S=8
COMMERCEMIND_LLM_TIMEOUT_S=15
COMMERCEMIND_COMPOSER_TIMEOUT_S=8

# ── 标准 MCP ─────────────────────────────────────────────────────────────────
# 默认连接无需 Key 的 Microsoft Learn 公开文档 MCP；设 false 可关闭外部连接。
MCP_EXTERNAL_ENABLED=true
# 不填时读取当前项目 config/mcp_servers.json，Docker 内默认路径同样可用。
# MCP_SERVERS_CONFIG=/app/config/mcp_servers.json
# 通过自定义域名访问 /mcp/ 时，将域名加入允许列表（逗号分隔）。
# MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,commercemind,commercemind:*,your-domain.example
# MCP_ALLOWED_ORIGINS=https://your-domain.example,http://localhost,http://localhost:*

# 本地默认 development；对外部署设置 production 并配置独立随机 API Token（不是模型 Key）。
COMMERCEMIND_ENV=development
# COMMERCEMIND_API_TOKENS={"至少24位随机Token":{"user_id":"u1","role":"user"},"另一管理员Token至少24位":{"user_id":"admin","role":"admin"}}

# 三路意图识别：有硅基流动 Key 自动启用 BAAI/bge-m3；无 Key 使用本地 n-gram。
INTENT_EMBEDDING_PROVIDER=auto
SILICONFLOW_API_KEY=
